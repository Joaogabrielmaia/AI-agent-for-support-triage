# Copie para .env e ajuste. Nenhum segredo deve ser versionado.
DATABASE_URL="postgresql://prumo:prumo@localhost:5440/prumo?schema=public"
SESSION_SECRET="troque-por-uma-string-aleatoria-longa"

# Provedor de linguagem: "mock" (padrão, determinístico) ou "anthropic"
LLM_PROVIDER="mock"
# Só necessária com LLM_PROVIDER=anthropic. Nunca versione.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-haiku-5-5"

# Preços por milhão de tokens (USD) usados SÓ na estimativa de custo do painel.
# Confira a tabela de preços vigente da Anthropic e preencha; vazio = custo não estimado.
PRICE_INPUT_PER_MTOK=""
PRICE_OUTPUT_PER_MTOK=""

# Limiar de confiança (similaridade de cosseno do melhor trecho)
CONFIDENCE_THRESHOLD="0.30"
